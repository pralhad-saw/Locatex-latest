<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard</title>
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="icon" type="image/png" href="/images/logo.png">    
  <link rel="apple-touch-icon" href="/images/logo.png">
  <style>
    /* General Reset */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body.admin-page {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-color: #f8f9fa;
      color: #333;
      padding: 20px;
    }

    h1, h2, h3 {
      color: #222;
      margin-bottom: 15px;
    }

    /* Messages */
    .welcome-msg {
      font-weight: bold;
      margin-bottom: 20px;
    }
    .welcome-msg.success { color: #28a745; }
    .welcome-msg.error { color: #dc3545; }

    /* Buttons */
    .btn {
      display: inline-block;
      padding: 10px 18px;
      border: none;
      border-radius: 5px;
      background-color: #4CAF50;
      color: white;
      font-size: 0.95rem;
      text-decoration: none;
      cursor: pointer;
      transition: background 0.3s;
    }
    .btn:hover { background-color: #45a049; }

    .btn.delete {
      background-color: #f44336;
    }
    .btn.delete:hover { background-color: #da190b; }

    .btn.view {
      background-color: #008CBA;
    }
    .btn.view:hover { background-color: #007ba7; }

    /* Tables */
    .table-container {
      width: 100%;
      overflow-x: auto; /* Responsive horizontal scroll */
      margin-bottom: 30px;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      min-width: 600px;
      background-color: #fff;
      border-radius: 8px;
      overflow: hidden;
      box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    }
    th, td {
      padding: 12px 15px;
      text-align: left;
    }
    th {
      background-color: #e9ecef;
      font-weight: 600;
    }
    tr:nth-child(even) {
      background-color: #f8f9fa;
    }

    /* Actions flex */
    .actions {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    /* Responsive Typography */
    @media (max-width: 768px) {
      body.admin-page {
        padding: 15px;
      }
      h1 { font-size: 1.8rem; }
      h2 { font-size: 1.4rem; margin-top: 25px; }
      .btn {
        padding: 8px 12px;
        font-size: 0.9rem;
      }
      th, td {
        padding: 10px 8px;
      }
    }

    @media (max-width: 480px) {
      h1 { font-size: 1.5rem; }
      h2 { font-size: 1.2rem; }
      table { min-width: 100%; }
      .actions { flex-direction: column; }
    }
  </style>
</head>
<body class="admin-page">

  <div class="admin-header" style="display: flex; align-items: center; gap: 15px; margin-bottom: 30px;">
    <img src="/images/logo.png" alt="LocateX Logo" style="width: 45px; height: 45px;">
    <h1 style="margin: 0; font-size: 1.8rem;">LocateX Admin</h1>
</div>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
    <h1>Admin Dashboard</h1>
    <a href="/items/all" class="btn toggle-btn">👁️ View as User (Dashboard)</a>
</div>

<% if (typeof user !== 'undefined' && user) { %>
  <p class="welcome-msg success">
    Welcome, <%= user.username %>! (Role: <%= user.role || 'missing role' %>)
  </p>
<% } else { %>
  <p class="welcome-msg error">
    DEBUG: user object is MISSING in EJS → session did not reach here
  </p>
<% } %>

<!-- Registered Users -->
<h2>Registered Users</h2>
<div class="actions">
  <form action="/download/users" method="GET">
    <button type="submit" class="btn">Download User Report (CSV)</button>
  </form>
</div>
<div class="table-container">
  <table>
    <thead>
      <tr>
        <th>Username</th>
        <th>Email</th>
        <th>Role</th>
        <th>Created At</th>
        <th>Actions</th>
      </tr>
    </thead>
    
    
    <tbody>
       <% if (users.length === 0) { %>
         <tr>
          <td colspan="5" style="text-align:center;">No users found.</td>
        </tr> 
        <% } else { %> 
          <% users.forEach(user => { %> 
            <tr> 
              <td data-label="Username"><%= user.username || 'N/A' %></td>
               <td data-label="Email"><%= user.email || 'N/A' %></td>
                <td data-label="Role"><%= user.role || 'user' %></td>
                 <td data-label="Created At"><%= user.createdAt ? new Date(user.createdAt).toLocaleString() : 'No date available' %></td> 
                 <td data-label="Actions" class="actions"> 
                  <form action="/admin/delete/user/<%= user._id %>" method="POST" onsubmit="return confirmDelete('user')">
                     <button class="btn delete">Delete</button>
                     </form> 
                    </td> 
                  </tr>
                   <% }) %> 
                   <% } %> 
                  </tbody>

  </table>
</div>

<!-- Lost & Found Items -->
<h2>Lost & Found Items</h2>
<div class="table-container">
  <table>
    <thead>
      <tr>
        <th>Title</th>
        <th>Description</th>
        <th>Type</th>
        <th>Owner</th>
        <th>Status</th>
        <th>Contact Visible</th>
        <th>Created At</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if (items.length === 0) { %>
    <tr><td colspan="8" style="text-align:center;">No items reported yet.</td></tr>
  <% } else { %>
      <% items.forEach(item => { %>
      <tr>
        <td><%= item.title %></td>
        <td><%= item.description %></td>
        <td><%= item.type %></td>
        <td><%= (item.ownerId && item.ownerId.username) ? item.ownerId.username : 'Unknown' %></td>
        <td><%= item.status %></td>
        <td><%= item.isContactVisible ? 'Yes' : 'No' %></td>
        <td><%= item.createdAt.toLocaleString() %></td>
        <td class="actions">
          <form action="/admin/delete/item/<%= item._id %>" method="POST" onsubmit="return confirmDelete('item')">
            <button class="btn delete">Delete</button>
          </form>
        </td>
      </tr>
      <% }) %>
      <% } %>
    </tbody>
  </table>
</div>

<!-- User Feedback -->
<h2>User Feedback</h2>
<div class="table-container">
  <table>
    <thead>
      <tr>
        <th>User</th>
        <th>Message</th>
        <th>Date</th>
        <th>Action</th>
      </tr>
    </thead>
    <tbody>
      <% if (feedbacks.length === 0) { %>
    <tr><td colspan="4" style="text-align:center;">No feedback received.</td></tr>
  <% } else { %>
      <% feedbacks.forEach(fb => { %>
      <tr>
        <td><%= fb.userId ? fb.userId.username : "Unknown" %></td>
        <td><%= fb.message %></td>
        <td><%= fb.date.toLocaleString() %></td>
        <td class="actions">
          <form action="/admin/delete/feedback/<%= fb._id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this feedback?')">
            <button class="btn delete">Delete</button>
          </form>
        </td>
      </tr>
      <% }) %>
           <% } %>
    </tbody>
  </table>
</div>

<!-- Download Items CSV -->
<div style="margin-top:20px;">
  <a href="/user/download-csv" class="btn" onclick="return confirm('Download CSV?')">Download Item Report (CSV)</a>
</div>

<script>
  function confirmDelete(type) {
    return confirm(`Are you sure you want to delete this ${type}?`);
  }
</script>
  <footer>
  <p>&copy; 2026 LocateX - Proprietary Technology. All Rights Reserved.</p>
  </footer>
</body>
</html>
