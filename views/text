const express = require("express");
const Item = require("../models/Item");
const router = express.Router();

// Add Item
router.post("/add", async (req, res) => {
  try {
    const { title, description, type, contact } = req.body;
    const newItem = new Item({
      title,
      description,
      type,
      contact,
      postedBy: req.session.user._id   // store logged-in user ID
    });
    await newItem.save();
    res.redirect("/dashboard");
  } catch (err) {
    console.error(err);
    res.status(500).send("Error adding item");
  }
});

// ✅ Get all items
router.get("/items/all", async (req, res) => {
  try {
    const items = await Item.find().populate("postedBy", "username");
    res.render("dashboard", { user: req.session.user, items });
  } catch (err) {
    res.status(500).send("Error fetching items");
  }
});

// ✅ Get only lost items
router.get("/items/lost", async (req, res) => {
  try {
    const items = await Item.find({ type: "lost" }).populate("postedBy", "username");
    res.render("dashboard", { user: req.session.user, items });
  } catch (err) {
    res.status(500).send("Error fetching lost items");
  }
});

// ✅ Get only found items
router.get("/items/found", async (req, res) => {
  try {
    const items = await Item.find({ type: "found" }).populate("postedBy", "username");
    res.render("dashboard", { user: req.session.user, items });
  } catch (err) {
    res.status(500).send("Error fetching found items");
  }
});

// ✅ Get items of logged-in user
router.get("/items/my", async (req, res) => {
  try {
    const items = await Item.find({ postedBy: req.session.user._id });
    res.render("dashboard", { user: req.session.user, items });
  } catch (err) {
    res.status(500).send("Error fetching my items");
  }
});

// ✅ Search items by title or description
router.get("/search", async (req, res) => {
  try {
    const query = req.query.q;
    const items = await Item.find({
      $or: [
        { title: { $regex: query, $options: "i" } },
        { description: { $regex: query, $options: "i" } }
      ]
    }).populate("postedBy", "username");
    res.render("dashboard", { user: req.session.user, items });
  } catch (err) {
    res.status(500).send("Error searching items");
  }
});





// Dashboard (User)
